-- unicodeSegmentation: splitting text into grapheme clusters, words and
-- sentences, by the rules of Unicode Standard Annex #29.
--
-- A port of Rust's `unicode-segmentation` crate, version 1.13.3, covering
-- Unicode 17.0.0. The tables are generated from the crate by
-- `scripts/generate.sh`, and the tests hold this port to the crate's answers
-- and to the official Unicode test data.
--
--   use unicodeSegmentation (graphemes, unicodeWords)
--
--   graphemes True "a\u{310}e\u{301}o\u{308}\u{332}"  -- ["a̐", "é", "ö̲"]
--   unicodeWords "The quick (\"brown\") fox can't jump 32.3 feet, right?"
--     -- ["The", "quick", "brown", "fox", "can't", "jump", "32.3", "feet", "right"]

mod Tables
mod Lookup
mod Text
mod Grapheme
mod Word
mod Sentence
mod Segment
@cfg(test)
mod Cases
@cfg(test)
mod Tests

